[Unit]
Description=Asipad kiosk display (cage + cog)
After=systemd-user-sessions.service kiosk-server.service network-online.target getty@tty1.service
Wants=kiosk-server.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=asi
Group=asi

PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

UtmpIdentifier=tty1
UtmpMode=user

# WPE WebKit's sandbox via bwrap mis-detects on this Pi OS image
# ("Unexpected capabilities but not setuid"). The kiosk only ever loads our
# own localhost content, so the sandbox is dead weight here.
Environment=WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1

# Wait for the local kiosk server before bringing up the display.
ExecStartPre=/bin/sh -c 'until curl -fsS http://127.0.0.1:8080/api/health > /dev/null 2>&1; do sleep 0.5; done'

# cage = single-window Wayland compositor.
# cog = WPE-WebKit kiosk browser.
# Together they replace lightdm + labwc + Firefox at a fraction of the RAM cost.
ExecStart=/usr/bin/cage -s -- /usr/bin/cog http://127.0.0.1:8080/

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
