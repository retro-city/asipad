[Unit]
Description=Asipad kiosk display (cage + cog)
After=systemd-user-sessions.service kiosk-server.service network-online.target getty@tty1.service
Wants=kiosk-server.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=asi
Group=asi

PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

UtmpIdentifier=tty1
UtmpMode=user

# WPE WebKit's sandbox via bwrap mis-detects on this Pi OS image
# ("Unexpected capabilities but not setuid"). The kiosk only ever loads our
# own localhost content, so the sandbox is dead weight here.
Environment=WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1

# Point labwc at our system-wide config (autostart + rc.xml) under
# /etc/asipad/labwc. The autostart unsets this so cog/wvkbd write to
# $HOME/.config like normal.
Environment=XDG_CONFIG_HOME=/etc/asipad

# Wait for the local kiosk server before bringing up the compositor.
ExecStartPre=/bin/sh -c 'until curl -fsS http://127.0.0.1:8080/api/health > /dev/null 2>&1; do sleep 0.5; done'

# labwc owns the display; its autostart launches wvkbd (on-screen keyboard,
# auto-shown via wp_text_input_v3) and cog -F (fullscreen WPE-WebKit kiosk).
# We use labwc instead of cage because cage doesn't expose wlr_layer_shell,
# which wvkbd needs to render the keyboard as an overlay.
ExecStart=/usr/bin/labwc

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
