[Unit]
Description=Asipad kiosk local server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/home/__USER__/asipad
ExecStart=/usr/bin/python3 -u /home/__USER__/asipad/server/app.py
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
